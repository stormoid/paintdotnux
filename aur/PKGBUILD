# Maintainer: stormoid
pkgname=paintnux-git
pkgver=r1
pkgrel=1
pkgdesc="A lightweight raster image editor inspired by Paint.NET"
arch=('x86_64')
url="https://github.com/stormoid/paintdotnux"
license=('MIT')
depends=('qt6-base' 'qt6-svg')
makedepends=('cmake' 'git')
provides=('paintnux')
conflicts=('paintnux')
source=("git+https://github.com/stormoid/paintdotnux.git")
sha256sums=('SKIP')

pkgver() {
    cd paintdotnux
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -S paintdotnux -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j"$(nproc)"
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
